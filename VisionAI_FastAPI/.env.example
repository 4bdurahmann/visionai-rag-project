# VisionAI Medical RAG - environment configuration
#
# Copy this file to `.env` and fill in the keys you want to use.
# The active LLM provider is picked automatically from the keys present below,
# or forced with LLM_PROVIDER (openrouter | gemini | alibaba | groq | openai).
# If Groq hits its daily token quota, requests fail over to the next provider.

# --- LLM providers (set at least one) ------------------------------------

# Groq         (gsk_...)  - primary provider; generous free tier but daily token cap
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_JUDGE_MODEL=openai/gpt-oss-120b

# OpenRouter   (sk-or-v1-...) - one key, 500+ models incl. free :free models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=gpt-4o-mini
OPENROUTER_JUDGE_MODEL=gpt-4o-mini

# Google Gemini (AIza...) - free key from Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_JUDGE_MODEL=gemini-2.5-flash

# Alibaba Cloud Model Studio / Qwen  (sk-ws-...) - OpenAI-compatible endpoint
ALIBABA_API_KEY=
ALIBABA_MODEL=qwen-plus
ALIBABA_JUDGE_MODEL=qwen-plus

# OpenAI direct (sk-proj-...) - only used directly if no other key is configured
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_JUDGE_MODEL=gpt-4o-mini

# --- Optional -------------------------------------------------------------

# Root-route project metadata (used by GET / via core.config.Settings)
# PROJECT_NAME=
# PROJECT_EVENT=
# PROJECT_ORGANIZERS=["Org A","Org B"]
# PROJECT_INSTRUCTORS=["Instructor A","Instructor B"]
# SUPERVISOR_TEAM=
# SUPERVISOR_MEMBER=["Member A","Member B"]
# PROJECT_DATE=

# LlamaParse / LlamaCloud (used when re-parsing the source PDF)
# LLAMAPARSE_APIKEY=

# Force a provider regardless of which keys are set.
# LLM_PROVIDER=

# Cohere (if used elsewhere in the pipeline)
# COHERE_API_KEY=